Функция РазностьМассивов(ОсновнойМассив, МассивДляИсключения)
	Для сч=0 По МассивДляИсключения.ВГраница() Цикл
		НайЭлем = ОсновнойМассив.Найти(МассивДляИсключения[сч]);
		Если НайЭлем <> Неопределено Тогда
			ОсновнойМассив.Удалить(НайЭлем);
		КонецЕсли;
	КонецЦикла;
	Возврат ОсновнойМассив;
КонецФункции


Функция ЧислоВРимское(АрабскоеЧисло)
        
    Результат = "";
    
    // Проверка на нечисловой тип
    Если ТипЗнч(АрабскоеЧисло) <> Тип("Число") Тогда
        Возврат "N";
    КонецЕсли;
    
    // Проверка на целое положительное число
    Если АрабскоеЧисло <= 0 ИЛИ АрабскоеЧисло > 3999 Тогда
        Возврат "N";
    КонецЕсли;
    
    // Жадный алгоритм: значения и соответствующие римские цифры
    Значения = Новый Массив;
    Значения.Добавить(1000);
    Значения.Добавить(900);
    Значения.Добавить(500);
    Значения.Добавить(400);
    Значения.Добавить(100);
    Значения.Добавить(90);
    Значения.Добавить(50);
    Значения.Добавить(40);
    Значения.Добавить(10);
    Значения.Добавить(9);
    Значения.Добавить(5);
    Значения.Добавить(4);
    Значения.Добавить(1);
    
    РимскиеЦифры = Новый Массив;
    РимскиеЦифры.Добавить("M");
    РимскиеЦифры.Добавить("CM");
    РимскиеЦифры.Добавить("D");
    РимскиеЦифры.Добавить("CD");
    РимскиеЦифры.Добавить("C");
    РимскиеЦифры.Добавить("XC");
    РимскиеЦифры.Добавить("L");
    РимскиеЦифры.Добавить("XL");
    РимскиеЦифры.Добавить("X");
    РимскиеЦифры.Добавить("IX");
    РимскиеЦифры.Добавить("V");
    РимскиеЦифры.Добавить("IV");
    РимскиеЦифры.Добавить("I");
    
    ЧислоДляПроверки = АрабскоеЧисло;
    
    // Жадный алгоритм преобразования
    Для Индекс = 0 По Значения.ВГраница() Цикл
        Пока ЧислоДляПроверки >= Значения[Индекс] Цикл
            Результат = Результат + РимскиеЦифры[Индекс];
            ЧислоДляПроверки = ЧислоДляПроверки - Значения[Индекс];
        КонецЦикла;
    КонецЦикла;
    
    Возврат Результат;
КонецФункции
