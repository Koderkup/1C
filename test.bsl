    УникЦифры = Новый Соответствие;
    Для Каждого Цифра Из ВходящийМассив Цикл
        УникЦифры.Вставить(Число(Цифра), Истина);
    КонецЦикла;
    
    
    СтрокаРезультата = "";
    Для Сч = 0 По 9 Цикл
        Если УникЦифры[Сч] = Истина Тогда
            СтрокаРезультата = СтрокаРезультата + Строка(Сч);
        КонецЕсли;
    КонецЦикла;
    
    Результат = ?(ЗначениеЗаполнено(СтрокаРезультата), Число(СтрокаРезультата), 0);
КонецЕсли;
//============================================================================================

Результат = Новый Массив;

Если ВходящийМассив.Количество() > 0 Тогда
МаксимальноеЗначение = ВходящийМассив[0];
ИндексМаксимального = 0;   

Для Счетчик = 1 По ВходящийМассив.ВГраница() Цикл

 Если ВходящийМассив[Счетчик] >  МаксимальноеЗначение Тогда
    МаксимальноеЗначение = ВходящийМассив[Счетчик];
    ИндексМаксимального = Счетчик;
 КонецЕсли;   
КонецЦикла;

Для Счетчик = ИндексМаксимального По ВходящийМассив.ВГраница() Цикл
    Если ВходящийМассив[Счетчик] = 0 Тогда
       Результат.Добавить(ВходящийМассив[Счетчик]);
       Иначе
       Результат.Добавить(ВходящийМассив[Счетчик] - 1);  
    КонецЕсли;
КонецЦикла;
КонецЕсли;

//====================================================================================================

Результат = Новый Массив;

Если СтрДлина(ВходящаяСтрока) % 2 <> 0 Тогда   
    ВходящаяСтрока = ВходящаяСтрока + "_";
КонецЕсли;

Сч = 1;

Пока Сч <= СтрДлина(ВходящаяСтрока) Цикл
    ПараСимволов = Сред(ВходящаяСтрока, Сч, 2);
    Результат.Добавить(ПараСимволов);
    Сч = Сч + 2;
КонецЦикла;



