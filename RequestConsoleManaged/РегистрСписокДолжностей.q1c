<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="СПД">
		<text> ВЫБРАТЬ
 СПД.ШтатнаяДолжность КАК Должность,
 Максимум(СПД.Дата) КАК Дата 
 ПОМЕСТИТЬ ВТ_Список
 ИЗ
 РегистрСведений.СПД КАК СПД 
  СГРУППИРОВАТЬ ПО
 СПД.ШтатнаяДолжность;
  ВЫБРАТЬ
  СПД1.ШтатнаяДолжность КАК Должность,
  СПД1.Дата КАК Дата,
  СПД1.Действие КАК Работает 
  ИЗ
  РегистрСведений.СПД КАК СПД1
  Внутреннее соединение
 ВТ_Список КАК ВТ_Список
 ПО
 (ВТ_Список.Должность = СПД1.ШтатнаяДолжность И ВТ_Список.Дата = СПД1.Дата И СПД1.Действие = ИСТИНА)
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
	</query>
</querylist>